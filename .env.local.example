# ==========================================
# 本地开发/生产环境 - 敏感配置
# cp .env.local.example .env.local
# ==========================================

# AI Bot 本地对话（必需）
AIBOT_LOCAL_ENABLED=1
NEXT_PUBLIC_ENABLE_AIBOT_LOCAL=1

# 本地对话访问密码（选填）
# 配置后，打开「本地对话」会先弹出密码蒙版，验证通过后才能使用；留空或不配置则不启用。
# 密码只在服务端校验（不要加 NEXT_PUBLIC_ 前缀），不会下发到浏览器。
# 修改后需重启 dev server 或重新 build。
AIBOT_ACCESS_PASSWORD=

# LLM 接口配置（推荐 primary/secondary 双模型）
AIBOT_LLM_PRIMARY_BASE_URL=http://XXXX/v1
AIBOT_LLM_PRIMARY_API_KEY=sk-XXXX
AIBOT_LLM_PRIMARY_MODEL=gpt-4.1-mini

# 可选：备用模型，主模型失败时自动切换
AIBOT_LLM_SECONDARY_BASE_URL=http://XXXX/v1
AIBOT_LLM_SECONDARY_API_KEY=sk-XXXX
AIBOT_LLM_SECONDARY_MODEL=gpt-4.1-mini

# 兼容旧配置：若未设置 PRIMARY_*，仍会读取以下单模型配置
# AIBOT_LLM_BASE_URL=http://XXXX/v1
# AIBOT_LLM_API_KEY=sk-XXXX
# AIBOT_LLM_MODEL=gpt-4.1-mini

# 深度检索网络搜索配置
# 按顺序自动降级：豆包 → Tavily → AnySearch → Exa；某个源报错或返回空结果时自动切到下一个
# 豆包搜索（火山引擎联网搜索）API Key，不配置则跳过豆包
# DOUBAO_API_KEY=your_doubao_api_key
# Tavily API Key，不配置则跳过 Tavily
# TAVILY_API_KEY=tvly-xxxxx
# AnySearch API Key（可选，留空则按 IP 匿名调用）
# ANYSEARCH_API_KEY=

# 可选：外网代理，格式必须包含协议头
# Docker 部署时不要直接假设 127.0.0.1 指向宿主机
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 图书检索 API 基础地址
BOOK_API_BASE_URL=http://10.40.92.18:8001

# 语义检索 - 稠密向量 lane（查询期 embed，开关见 .env.example）
# 只有 EMBEDDING_API_KEY 是敏感值且必需；未配置时稠密 lane 降级为纯词法，检索仍可用
# EMBEDDING_MODEL / EMBEDDING_DIM 必须与建库（npm run build:vectors）时一致
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-XXXX
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_MS=1500

# 语义检索 - 对外 API 访问鉴权密钥（选填）
# 未配置时开放访问（适合本地开发/内网调用）；配置后外部项目/Agent 调用必须携带 Bearer Token 或 x-api-key
# SEARCH_API_KEY=your_search_api_key
