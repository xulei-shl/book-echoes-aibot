# ==========================================
# 本地开发/生产环境 - 敏感配置
# cp .env.local.example .env.local
# ==========================================

# AI Bot 本地对话（必需）
AIBOT_LOCAL_ENABLED=1
NEXT_PUBLIC_ENABLE_AIBOT_LOCAL=1

# LLM 接口配置（推荐 primary/secondary 双模型）
AIBOT_LLM_PRIMARY_BASE_URL=http://XXXX/v1
AIBOT_LLM_PRIMARY_API_KEY=sk-XXXX
AIBOT_LLM_PRIMARY_MODEL=gpt-4.1-mini

# 可选：备用模型，主模型失败时自动切换
AIBOT_LLM_SECONDARY_BASE_URL=http://XXXX/v1
AIBOT_LLM_SECONDARY_API_KEY=sk-XXXX
AIBOT_LLM_SECONDARY_MODEL=gpt-4.1-mini

# 兼容旧配置：若未设置 PRIMARY_*，仍会读取以下单模型配置
# AIBOT_LLM_BASE_URL=http://XXXX/v1
# AIBOT_LLM_API_KEY=sk-XXXX
# AIBOT_LLM_MODEL=gpt-4.1-mini

# 深度检索网络搜索配置
# 未配置 JINA_API_KEY 时会自动回退到 DuckDuckGo
USE_JINA_SEARCH=true
# JINA_API_KEY=jina_xxxxx

# 可选：外网代理，格式必须包含协议头
# Docker 部署时不要直接假设 127.0.0.1 指向宿主机
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 图书检索 API 基础地址
BOOK_API_BASE_URL=http://10.40.92.18:8001
