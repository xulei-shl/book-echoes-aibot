# WebSearch 检索源环境变量配置模板
# 拷贝本文件为 .env 并在下方填入您的 API Key

# 1. AnySearch API Key (可选，留空则按 IP 每日免费匿名限流调用)
ANYSEARCH_API_KEY=

# 2. Exa 神经语义检索 Key (可选)
EXA_API_KEY=

# 3. Tavily 事实检索 Key (可选)
TAVILY_API_KEY=

# 4. 豆包 (火山引擎联网搜索) Key (可选)
DOUBAO_API_KEY=

# 5. 知乎开发者平台 Access Secret (可选，用于知乎站内、全网搜索与知乎直答)
ZHIHU_ACCESS_SECRET=

# 6. Wikipedia User-Agent (必填Wikimedia政策合规标头，已有默认值)
# @dc-default
WIKIPEDIA_USER_AGENT=WebSearchSkill/1.0 (agentic-skills; contact@example.com)

# 7. 请求超时时间 (秒，默认 15)
# @dc-default
WEB_SEARCH_TIMEOUT=15

# 8. AnySearch 服务端点 (可选，默认官方地址；仅测试代理或私有部署时需覆盖)
# @dc-default
ANYSEARCH_API_BASE_URL=https://api.anysearch.com
