# ==========================================
# 客户端/公共配置 - 可提交到 Git
# cp .env.example .env
# ==========================================

# Cloudflare R2 配置（R2 需在 .env 中，因为 Next.js 服务端需要访问）
R2_ENDPOINT=https://XXXXXXXXXXXX.r2.cloudflarestorage.com
R2_BUCKET_NAME=XXXX
R2_BASE_PATH=data
R2_FONTS_PATH=fonts
R2_PUBLIC_URL=https://XXXX
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# 前端直连地址
NEXT_PUBLIC_R2_PUBLIC_URL=https://XXXX

TYPESAFE_API_KEY=your_typesafe_api_key

# 语义检索模块（默认关闭，不影响现有页面）
# 取值：0 = 关闭（默认），1 = 开启。下面两个开关都要设成 1，功能才真正可用。
#   SEMANTIC_SEARCH_ENABLED：服务端开关。为 0 时 /api/semantic-search 一律返回 404
#   NEXT_PUBLIC_ENABLE_SEMANTIC_SEARCH：前端入口开关。为 0 时首页/顶栏不渲染「语义检索」入口
# 注：NEXT_PUBLIC_* 在构建期内联，改动后需重启 dev server 或重新 build 才生效。
# 语义检索所需的 EMBEDDING_* 变量（含必需的 EMBEDDING_API_KEY）见 .env.local.example
SEMANTIC_SEARCH_ENABLED=0
NEXT_PUBLIC_ENABLE_SEMANTIC_SEARCH=0