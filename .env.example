# ==========================================
# 客户端/公共配置 - 可提交到 Git
# cp .env.example .env
# ==========================================

# Cloudflare R2 配置（R2 需在 .env 中，因为 Next.js 服务端需要访问）
R2_ENDPOINT=https://XXXXXXXXXXXX.r2.cloudflarestorage.com
R2_BUCKET_NAME=XXXX
R2_BASE_PATH=data
R2_FONTS_PATH=fonts
R2_PUBLIC_URL=https://XXXX
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# 前端直连地址
NEXT_PUBLIC_R2_PUBLIC_URL=https://XXXX