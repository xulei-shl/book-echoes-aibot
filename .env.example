# ==========================================
# 客户端/公共配置 - 可提交到 Git
# cp .env.example .env
# ==========================================

# Cloudflare R2 配置（R2 需在 .env 中，因为 Next.js 服务端需要访问）
R2_ENDPOINT=https://XXXXXXXXXXXX.r2.cloudflarestorage.com
R2_BUCKET_NAME=XXXX
R2_BASE_PATH=data
R2_FONTS_PATH=fonts
R2_PUBLIC_URL=https://XXXX
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# 前端直连地址
NEXT_PUBLIC_R2_PUBLIC_URL=https://XXXX

TYPESAFE_API_KEY=your_typesafe_api_key

# 语义检索模块（默认关闭，不影响现有页面）
# 取值：0 = 关闭（默认），1 = 开启。下面两个开关都要设成 1，功能才真正可用。
#   SEMANTIC_SEARCH_ENABLED：服务端开关。为 0 时 /api/semantic-search 一律返回 404
#   NEXT_PUBLIC_ENABLE_SEMANTIC_SEARCH：前端入口开关。为 0 时首页/顶栏不渲染「语义检索」入口
# 注：NEXT_PUBLIC_* 在构建期内联，改动后需重启 dev server 或重新 build 才生效。
# 语义检索所需的 EMBEDDING_* 变量（含必需的 EMBEDDING_API_KEY）见 .env.local.example
SEMANTIC_SEARCH_ENABLED=0
NEXT_PUBLIC_ENABLE_SEMANTIC_SEARCH=0

# ── 可选：检索质量阈值临时覆盖（应急用，默认值见 lib/search/tuning.ts）────────────────
# 默认值写在代码里、随版本发布；这里只用于线上应急调参，**不需要重新部署**。
# 规则：越界/非数字一律拒绝并回传原因（响应里的 tuning.rejected），绝不静默生效；
#      本次生效值会原样回传在响应里（tuning.effective / tuning.overridden），便于排查「线上为什么和本地不一样」。
# 改完想恢复默认：删掉变量即可（不缓存，下一次请求立即生效）。
# 注意：字段权重（FIELD_WEIGHTS）不可覆盖 —— 它影响索引构建，且必须与建库脚本一致。
#
# SEMANTIC_SEARCH_FIT_GATE_POSITION=0.9   # 门控位置（单位=档位，档数4 → 0.9≈fit 0.30），范围 0–3
# SEMANTIC_SEARCH_MIN_RESULTS=1           # 通过门控的候选少于此数即弃权，整数 1–10
# SEMANTIC_SEARCH_W_FIT=1.0               # Jev 档位 fit 的权重，0–5
# SEMANTIC_SEARCH_W_FACET=0.2             # 本地软先验总权重，0–5
# SEMANTIC_SEARCH_FACET_WEIGHT_FICTION=0.35   # 分项权重，0–1；四项合计不得超过 0.95，超了四项一起退回默认
# SEMANTIC_SEARCH_FACET_WEIGHT_RECENT=0.25
# SEMANTIC_SEARCH_FACET_WEIGHT_THEORY=0.2
# SEMANTIC_SEARCH_FACET_WEIGHT_VERIFIED=0.15
# SEMANTIC_SEARCH_RECENCY_FULL_YEARS=5    # 视为「新鲜」的年数，整数 0–50
# SEMANTIC_SEARCH_RECENCY_DECAY_YEARS=10  # 之后的线性衰减跨度（年），整数 1–100
# SEMANTIC_SEARCH_RRF_K=60                # 融合平滑参数，1–1000
# SEMANTIC_SEARCH_BM25_K1=1.2             # tf 饱和，0–10
# SEMANTIC_SEARCH_BM25_B=0.75             # 长度归一化，0–1
# SEMANTIC_SEARCH_UNSEEN_TERM_IDF=0.1     # 词表外词的 IDF，0–10
# SEMANTIC_SEARCH_DEFAULT_MAX_TERMS=16    # 查询词截断上限，整数 1–64
# SEMANTIC_SEARCH_DEEP_TOP_K_SLACK=20     # deep 模式多留的候选数，整数 0–200
# SEMANTIC_SEARCH_WIDER_RECALL_TRIGGER=0.5    # 宽召回触发点，0–1
# SEMANTIC_SEARCH_JEV_HARD_STRICTNESS=0.6     # 模型条件升级成硬过滤的严格性下限，0–1
# SEMANTIC_SEARCH_JEV_NEGATION_MAX=0.5        # 句中有否定时（> 此值）不采纳模型正向约束，0–1

# 结构上限类（几乎不用改）：分片大小/最大分片数/每分钟 Jev 预算/强制 fast 阈值
# SEMANTIC_SEARCH_WIDE_SHARD=50
# SEMANTIC_SEARCH_MAX_SHARDS=16
# SEMANTIC_SEARCH_JEV_BUDGET_PER_MIN=60
# SEMANTIC_SEARCH_FORCE_FAST_ABOVE=3000